<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.a730.mesa.egl263.ubwc"
    android:versionCode="3"
    android:versionName="26.3.0-rc1-egl-r10-Gallium-EXP">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="Mesa Freedreno A730 (26.3 UBWC)"
        android:hasCode="false"
        android:extractNativeLibs="true"
        android:allowBackup="false">

        <!-- FCL 用 queryIntentActivities(ACTION_MAIN) 扫插件，必须有 MAIN activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Mesa Freedreno A730 26.3 UBWC">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FCL renderer plugin v1: POJAV_RENDERER=opengles3_desktopgl_* 走 gl_bridge(EGL) 路径 -->
        <meta-data android:name="fclPlugin" android:value="true" />
        <meta-data android:name="des" android:value="Gallium-EXP" />
        <meta-data android:name="renderer" android:value="Gallium-EXP:libEGL_freedreno.so:libEGL_freedreno.so" />
        <meta-data android:name="boatEnv" android:value="" />
        <meta-data android:name="pojavEnv" android:value="POJAV_RENDERER=opengles3_desktopgl_freedreno:LIBGL_ES=3:MESA_GL_VERSION_OVERRIDE=4.6:MESA_GLSL_VERSION_OVERRIDE=460:allow_higher_compat_version=true:force_glsl_extensions_warn=true" />
        <meta-data android:name="minMCVer" android:value="" />
        <meta-data android:name="maxMCVer" android:value="" />
    </application>
</manifest>
